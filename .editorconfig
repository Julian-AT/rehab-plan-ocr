root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{swift,yml,yaml,json,sh}]
indent_size = 2

[{Makefile,*.mk}]
indent_style = tab

[docs/third-party/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false

[packages/apple/VoiceActivity/Sources/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
