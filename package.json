{
  "name": "rehab-plan-ocr",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 1420",
    "build": "next build",
    "preview": "serve out --listen 1420",
    "tauri": "tauri",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "models:fetch": "uv run scripts/fetch-models.py --tier small",
    "test:core": "cargo test -p reha-core",
    "verify": "npm run lint && npm run build && npm test && cargo test -p reha-core",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^0.577.0",
    "next": "^16.3.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^22",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "prettier": "^3",
    "serve": "^14",
    "tailwindcss": "^4",
    "typescript": "~5.9.0",
    "vitest": "^4.1.11"
  }
}
