# Private documents, annotations, models, and experiment output
/.local/
/data/private/
/artifacts/
/models/private/
*.sqlite*
*.onnx
*.gguf
.env*

# Dependencies and generated assets
/target/
.venv/
**/.build/
**/*.xcodeproj/
__pycache__/
*.pyc

# Build, test, and local OS output
*.dylib
*.xcframework/
*.ipa
*.app/
*.log
.DS_Store
/test-results/
/coverage/

# Incoming private evaluation images; keep out of commits and build contexts.
/verify/

# Standalone native build products; XcodeGen specification is authoritative.
/apps/ios/build/
/apps/ios/*.xcodeproj/
**/xcuserdata/

# Local visual references; never bundle or publish.
/beispiel.webp
/voice.webp
/.tools/
.ruff_cache/
*.tsbuildinfo
**/.tauri/
